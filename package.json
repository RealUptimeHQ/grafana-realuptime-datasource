{
  "name": "realuptime-monitor-datasource",
  "version": "0.1.1",
  "description": "Official RealUptime Monitor data source plugin for Grafana. Queries GET /api/v1/checks/results for panel time series and GET /api/v1/incidents for outage annotations.",
  "author": "RealUptime",
  "license": "Apache-2.0",
  "scripts": {
    "build": "webpack -c ./.config/webpack/webpack.config.ts --env production",
    "dev": "webpack -w -c ./.config/webpack/webpack.config.ts --env development",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "sign": "sign-plugin"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@grafana/data": "^13.3.0",
    "@grafana/runtime": "^13.3.0",
    "@grafana/schema": "^13.3.0",
    "@grafana/ui": "^13.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@grafana/eslint-config": "^10.0.0",
    "@grafana/sign-plugin": "^3.3.3",
    "@grafana/tsconfig": "^2.2.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/core": "^1.16.21",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-webpack-plugin": "^6.0.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "glob": "^14.0.3",
    "imports-loader": "^5.0.0",
    "prettier": "^3.9.10",
    "replace-in-file-webpack-plugin": "^1.0.0",
    "swc-loader": "^0.2.0",
    "terser-webpack-plugin": "^5.3.0",
    "ts-node": "^10.9.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-livereload-plugin": "^3.0.2",
    "webpack-subresource-integrity": "^5.1.0",
    "webpack-virtual-modules": "^0.6.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RealUptimeHQ/grafana-realuptime-datasource"
  },
  "homepage": "https://realuptime.io/docs/api"
}
